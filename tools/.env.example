# daily-invest-oss: local secrets file for tools/broker_alpaca.py and tools/notify.py
#
# 1) Copy this file to tools/.env (tools/.env is gitignored, never commit it).
# 2) Paste PAPER trading keys from the Alpaca dashboard (switch the dashboard to "Paper").
#    Treat them like a password: anyone who has them can trade that account.
#    Keep this file private (chmod 600 tools/.env) and regenerate the keys after any leak.
# 3) Offline check:              python3 tools/broker_alpaca.py --selftest
#    Live check (network, paper): python3 tools/broker_alpaca.py --probe
#
# Only the keys below are read from this file. Values exported in the shell win.

ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Optional push notifications via ntfy.sh (tools/notify.py). The topic works like a
# password: choose a long random name and keep it secret. Empty = no pushes.
NTFY_TOPIC=

# Live trading stays locked by default. A live (non-paper) endpoint needs BOTH
# allow_live=true in tools/exec_bot_config.json AND this variable exported in the
# shell environment (it is NOT read from this file):
#   export EXEC_BOT_ALLOW_LIVE=1
# Live mode trades REAL MONEY and prints a warning. Not financial advice.

# Environment-only settings (export them in your shell, they are NOT read from this
# file). See .env.example in the repository root for the full list, for example:
#   export DAILYINVEST_USER_AGENT="daily-invest-oss/1.0 (you@example.com)"
#   export SEC_USER_AGENT="Your Name you@example.com"
#   export DAILYINVEST_REPO=/path/to/daily-invest-oss
#   export DAILYINVEST_PYTHON=/usr/bin/python3
#   export TRADE_JOURNAL_DB=/path/to/trade_journal.sqlite

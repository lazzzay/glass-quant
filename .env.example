# daily-invest-oss: environment variables (reference list)
#
# The Python tools read os.environ directly; there is no automatic .env loader.
# Export what you need in your shell (or in your scheduler), for example:
#   export SEC_USER_AGENT="Your Name you@example.com"
# Exception: ALPACA_KEY_ID, ALPACA_SECRET_KEY and NTFY_TOPIC can also live in
# tools/.env (see tools/.env.example).
#
# Never commit a real .env file. Everything below is optional unless noted.
# Settings are commented out on purpose: an exported EMPTY value can break
# the defaults (for example DASHBOARD_API_PORT="" or DAILYINVEST_REPO="").

# ---------------------------------------------------------------------------
# Broker: Alpaca, paper trading by default (tools/broker_alpaca.py, tools/exec_bot.py)
# ---------------------------------------------------------------------------
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Second key of the live double lock (the first is allow_live=true in
# tools/exec_bot_config.json). Live mode trades REAL MONEY. Leave unset.
# EXEC_BOT_ALLOW_LIVE=1

# ---------------------------------------------------------------------------
# Notifications (tools/notify.py), secret random topic name
# ---------------------------------------------------------------------------
NTFY_TOPIC=

# ---------------------------------------------------------------------------
# HTTP identity for data providers
# ---------------------------------------------------------------------------
# SEC EDGAR fair-access policy: a real contact of the person running the tool.
# SEC_USER_AGENT="Your Name you@example.com"
# User-Agent for CBOE/Yahoo requests in tools/options_flow.py
# DAILYINVEST_USER_AGENT="daily-invest-oss/1.0 (you@example.com)"

# ---------------------------------------------------------------------------
# Paths and runtime
# ---------------------------------------------------------------------------
# Repo root and python used by tools/run_morning_pipeline.py
# (defaults: this repository and the current python)
# DAILYINVEST_REPO=/path/to/daily-invest-oss
# DAILYINVEST_PYTHON=/usr/bin/python3
# Trade journal SQLite file (default: <repo>/trade_journal.sqlite)
# TRADE_JOURNAL_DB=/path/to/trade_journal.sqlite
# launchd label prefix (default com.dailyinvest), keep install and verify in sync
# DAILYINVEST_LAUNCHD_PREFIX=com.dailyinvest

# ---------------------------------------------------------------------------
# Scanner (tools/daily_scanner.py)
# ---------------------------------------------------------------------------
# Optional ticker exclusion list, comma separated (also config/blacklist.txt)
# DAILYINVEST_BLACKLIST=AAA,BBB
# DAILYINVEST_BLACKLIST_FILE=/path/to/blacklist.txt
# Pacing and throttle budget for batch downloads (seconds)
# SCAN_CHUNK_SLEEP=1.0
# SCAN_THROTTLE_MAX_S=150
# yfinance tz cache directory (default: <system temp>/dailyinvest_yf_cache)
# DAILYINVEST_YF_CACHE_DIR=/path/to/cache
# Opt-in: allow deleting the global yfinance cache in ~/Library/Caches on cache errors
# DAILYINVEST_RESET_YF_HOME_CACHE=1
# SSL_CERT_FILE / REQUESTS_CA_BUNDLE are set automatically (certifi) when unset.

# ---------------------------------------------------------------------------
# Journal and costs (tools/quick_trade.py)
# ---------------------------------------------------------------------------
# Flat broker fee per order in EUR (default 1.0)
# DAILYINVEST_ORDER_FEE_EUR=1.0

# ---------------------------------------------------------------------------
# Local dashboard (tools/dashboard_api.py, binds 127.0.0.1 only)
# ---------------------------------------------------------------------------
# DASHBOARD_API_PORT=5757
# DASHBOARD_API_BASE=http://127.0.0.1:5757
# DASHBOARD_TASKS_DIR=/path/to/scheduled-tasks
# DASHBOARD_BRIEFING_GLOBS=Briefings/*Briefing*.md
# DASHBOARD_TRUST_ANCHORS=SourceA:keyword1|keyword2;SourceB:keyword3

# ---------------------------------------------------------------------------
# Sizing (tools/kelly_sizer.py)
# ---------------------------------------------------------------------------
# KELLY_TARGET_VOL=0.15
# KELLY_RISK_API_TIMEOUT=3.0

# ---------------------------------------------------------------------------
# Sentiment models (tools/findpo_scorer.py)
# ---------------------------------------------------------------------------
# FINDPO_MODEL=/path/or/huggingface-model-id

# ---------------------------------------------------------------------------
# Reddit (signals/reddit_trending.py, optional, check Reddit's API terms)
# ---------------------------------------------------------------------------
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT="daily-invest-oss/1.0 by your-reddit-username"
